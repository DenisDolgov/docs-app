{
  "name": "@docs-app/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @docs-app/docs-frontend dev",
    "dev:backend": "pnpm --filter @docs-app/docs-backend dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "lefthook": "^2.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3"
}
