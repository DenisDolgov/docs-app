NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:pass@localhost:5432/docs
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://user:pass@localhost:5672
JWT_ACCESS_SECRET=dev-access-secret-change-me
CORS_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=user
S3_SECRET_KEY=pass-secret
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Docs <noreply@docs.local>
APP_URL=http://localhost:3000
# Атрибуты refresh-куки. Access-кука `__Host-` всегда Secure/Strict/Path=/.
# SameSite=None допустим только вместе с COOKIE_SECURE=true.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com
# Доверять X-Forwarded-For (только за известным прокси/балансировщиком).
TRUST_PROXY=false
